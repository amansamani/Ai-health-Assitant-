# Backend API base URL
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Google Sign-In — must be the WEB-type OAuth client ID from Google Cloud
# Console (not Android/iOS). Same value goes in the backend's
# GOOGLE_WEB_CLIENT_ID. Not a secret — safe to commit the real value if you
# want, but keeping it in .env matches how EXPO_PUBLIC_API_URL is handled.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
