{
  "expo": {
    "name": "Fitlip",
    "slug": "ai-health-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aihealthfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FitLip needs camera access to check your exercise form."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#29195A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "package": "com.amansamani.aihealthfrontend",
        "permissions": [
          "android.permission.CAMERA",
          "android.permission.CAMERA"
        ]
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.amansamani.aihealthfrontend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
           "image": "./assets/images/splash-fullscreen.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "26.3.11579264"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "201b359d-32f6-4d73-916e-4e3d6fc64d2d"
      }
    },
    "owner": "aman-samani",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/201b359d-32f6-4d73-916e-4e3d6fc64d2d"
    }
  }
}
